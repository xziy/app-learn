.secrets/
keystore.properties
*.jks
*.keystore
*.p12
*.p8
*.pem
*.key
*.mobileprovision
google-services*.json
GoogleService-Info*.plist

# Release packages.
*.apk
*.aab
*.ipa

# IDEs and editors.
.idea/
*.iml
.vscode/
*.swp
*~
.DS_Store

# Local state of the AI tools.
.claude/settings.local.json
.playwright-mcp/
